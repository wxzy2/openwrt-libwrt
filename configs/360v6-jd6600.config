CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y

### 京东云 AX6600（雅典娜）：额外内置 athena-led、openlist2、aria2 ###
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn luci-app-openlist2 luci-i18n-openlist2-zh-cn openlist2 luci-app-aria2 luci-i18n-aria2-zh-cn aria2 ariang"

### 360 V6：General.config 里的 ddns-go 和 openclash，再加 zram 内存压缩（内存小，AX6600 内存大不需要）###
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_qihoo_360v6=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_qihoo_360v6="zram-swap kmod-lib-lz4"

### 两个设备共用 ###
### NSS 版本是整次编译全局的，两台设备必须一致；11.4 + 6.12 是已验证能编译的组合 ###
### 注意：NSS 12.5 在 6.12 上 qca-nss-ecm 会编译失败，不要单独改成 12_5 ###
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y

### 仅 360 V6 使用的 zram（=m 只编译不全局安装，由上面的 DEVICE_PACKAGES 装进 360 V6）###
CONFIG_PACKAGE_zram-swap=m
CONFIG_PACKAGE_kmod-lib-lz4=m
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### 仅 AX6600 使用的软件包（=m 只编译不全局安装，由上面的 DEVICE_PACKAGES 装进对应设备）###
CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

CONFIG_PACKAGE_openlist2=m
CONFIG_PACKAGE_luci-app-openlist2=m
CONFIG_PACKAGE_luci-i18n-openlist2-zh-cn=m

CONFIG_PACKAGE_aria2=m
CONFIG_PACKAGE_ariang=m
CONFIG_PACKAGE_luci-app-aria2=m
CONFIG_PACKAGE_luci-i18n-aria2-zh-cn=m

CONFIG_ARIA2_OPENSSL=y
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
CONFIG_ARIA2_EXPAT=y
# CONFIG_ARIA2_NOXML is not set
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_METALINK=y
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
# CONFIG_ARIA2_COOKIE is not set
CONFIG_ARIA2_WEBSOCKET=y
