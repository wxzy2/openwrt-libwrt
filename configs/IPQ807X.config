CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y

### Linksys MX4300（只编译这一台，其他 ipq807x 设备一律不编译）###
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4300=y

### NSS 11.4 + 6.12 内核（与 360v6-jd6600 流程相同的已验证组合）###
### MX4300 是 2GB 内存，不要加 CONFIG_ATH11K_MEM_PROFILE_512M（那是给 512MB 机型用的），使用源码默认的 ath11k 内存档位 ###
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y

### 精简：NSS 版 SQM 脚本没有 luci-app-sqm 配套，用不上 ###
CONFIG_PACKAGE_sqm-scripts-nss=n

### 插件与京东云 AX6600 相同（OpenClash、DDNS-Go 在 General.config 里），不含 athena-led ###

### OpenList2 ###
CONFIG_PACKAGE_openlist2=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-i18n-openlist2-zh-cn=y

### Aria2 + AriaNg ###
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-i18n-aria2-zh-cn=y

CONFIG_ARIA2_OPENSSL=y
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
CONFIG_ARIA2_EXPAT=y
# CONFIG_ARIA2_NOXML is not set
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_METALINK=y
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
# CONFIG_ARIA2_COOKIE is not set
CONFIG_ARIA2_WEBSOCKET=y
